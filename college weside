<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>VP College</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 text-gray-800">

<!-- ================= NAVBAR ================= -->
<header class="bg-blue-900 text-white shadow">
  <div class="max-w-7xl mx-auto flex justify-between items-center p-4">
    <h1 class="text-2xl font-bold">VP College</h1>
    <nav class="space-x-6">
      <a href="#home" class="hover:text-yellow-300">Home</a>
      <a href="#about" class="hover:text-yellow-300">About</a>
      <a href="#courses" class="hover:text-yellow-300">Courses</a>
      <a href="#gallery" class="hover:text-yellow-300">Gallery</a>
      <a href="#contact" class="hover:text-yellow-300">Contact</a>
    </nav>
  </div>
</header>

<!-- ================= HERO ================= -->
<section id="home" class="bg-blue-700 text-white text-center py-24">
  <h2 class="text-4xl font-bold mb-4">Welcome to VP College</h2>
  <p class="text-xl mb-6">Quality Education • Bright Future</p>
  <a href="#courses" class="bg-white text-blue-700 px-6 py-3 rounded-lg font-semibold hover:bg-gray-200">
    View Courses
  </a>
</section>

<!-- ================= ABOUT ================= -->
<section id="about" class="max-w-6xl mx-auto py-16 px-4">
  <h3 class="text-3xl font-bold text-center mb-6">About VP College</h3>
  <p class="text-center max-w-3xl mx-auto">
    VP College is committed to excellence in higher education.  
    We offer Arts, Science, and Commerce programs with experienced faculty and modern facilities.
  </p>
</section>

<!-- ================= COURSES ================= -->
<section id="courses" class="bg-white py-16">
  <h3 class="text-3xl font-bold text-center mb-10">Our Courses</h3>

  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 px-4">
    <div class="bg-gray-100 p-6 rounded-xl shadow">
      <h4 class="text-xl font-bold mb-2">B.Sc (Science)</h4>
      <p>Physics, Chemistry, Mathematics, Computer Science</p>
    </div>

    <div class="bg-gray-100 p-6 rounded-xl shadow">
      <h4 class="text-xl font-bold mb-2">B.A (Arts)</h4>
      <p>English, History, Political Science, Sociology</p>
    </div>

    <div class="bg-gray-100 p-6 rounded-xl shadow">
      <h4 class="text-xl font-bold mb-2">B.Com (Commerce)</h4>
      <p>Accounting, Banking, Business Management</p>
    </div>
  </div>
</section>

<!-- ================= GALLERY ================= -->
<section id="gallery" class="max-w-6xl mx-auto py-16 px-4">
  <h3 class="text-3xl font-bold text-center mb-10">Gallery</h3>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
    <img src="https://via.placeholder.com/400x250" class="rounded-lg shadow">
    <img src="https://via.placeholder.com/400x250" class="rounded-lg shadow">
    <img src="https://via.placeholder.com/400x250" class="rounded-lg shadow">
  </div>
</section>

<!-- ================= CONTACT ================= -->
<section id="contact" class="bg-blue-900 text-white py-16">
  <div class="max-w-4xl mx-auto text-center px-4">
    <h3 class="text-3xl font-bold mb-6">Contact Us</h3>
    <p class="mb-2">📍 Vaijapur, Maharashtra</p>
    <p class="mb-2">📧 info@vpcollege.org</p>
    <p>📞 +91 98765 43210</p>
  </div>
</section>

<!-- ================= FOOTER ================= -->
<footer class="bg-blue-950 text-white text-center p-4">
  <p>© 2026 VP College. All Rights Reserved.</p>
</footer>

</body>
</html>
